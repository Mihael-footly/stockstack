# Copy to .env.local and fill in from the Supabase dashboard (Project Settings
# -> API). The publishable/anon key is safe in a client bundle; the
# service-role key is NOT and is deliberately not used anywhere in this app.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable-key>

# Used to build the auth redirect URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
